<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="wails-v3.exe"
        Arguments=""
        InstallLocation="C:\Program Files\taqu\MeiliScope PoC">
    </Installer>
    <PackageInformation
        PackageName="MeiliScope PoC"
        PackageDisplayName="MeiliScope PoC"
        PublisherName="CN=taqu"
        PublisherDisplayName="taqu"
        Version="0.0.1.0"
        PackageDescription="Wails v3 feasibility PoC">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
