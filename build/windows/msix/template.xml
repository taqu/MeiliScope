<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="meiliscope.exe"
        Arguments=""
        InstallLocation="C:\Program Files\taqu\MeiliScope">
    </Installer>
    <PackageInformation
        PackageName="MeiliScope"
        PackageDisplayName="MeiliScope"
        PublisherName="CN=taqu"
        PublisherDisplayName="taqu"
        Version="0.1.0.0"
        PackageDescription="Desktop browser for Meilisearch">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.taqu.meiliscope"
                Description="Desktop browser for Meilisearch"
                DisplayName="MeiliScope"
                ExecutableName="meiliscope.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>MeiliScope</DisplayName>
            <PublisherDisplayName>taqu</PublisherDisplayName>
            <Description>Desktop browser for Meilisearch</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="meiliscope.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
